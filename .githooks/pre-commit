#!/bin/sh
set -eu

STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACMR)"

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

if ! printf '%s\n' "$STAGED_FILES" | grep -Eq '^(resources/js/|package\.json|package-lock\.json|eslint\.config\.js|tsconfig\.json|vite\.config\.ts|\.github/workflows/lint\.yml)$'; then
    exit 0
fi

if [ ! -x "./vendor/bin/sail" ]; then
    printf '%s\n' 'Pre-commit lint skipped: ./vendor/bin/sail is missing. Run the project setup first.' >&2
    exit 1
fi

printf '%s\n' 'Running frontend lint check in Sail...'
./vendor/bin/sail npm run lint:check
